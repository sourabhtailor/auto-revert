#!/bin/bash

# Number of files to create
NUM_FILES=150

# Target directory for fake files
TARGET_DIR="./fake_php_src"

# Lines of code per file (increase to grow file size)
LINES_PER_FILE=1000

# Create the target directory
mkdir -p "$TARGET_DIR"

# Sample fake PHP code snippet
generate_php_code() {
  for ((i = 1; i <= $LINES_PER_FILE; i++)); do
    echo "<?php // Line $i: echo 'Hello World $i'; ?>" >> "$1"
  done
}

echo "Creating $NUM_FILES fake PHP files in $TARGET_DIR..."

for ((i = 1; i <= $NUM_FILES; i++)); do
  FILE_PATH="$TARGET_DIR/fake_file_$i.php"
  generate_php_code "$FILE_PATH"
done

echo "✅ Done. Generated $NUM_FILES files with ~$((NUM_FILES * LINES_PER_FILE)) lines total."
