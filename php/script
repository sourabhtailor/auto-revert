#!/bin/bash

# Directory to create files in (change as needed)
OUTPUT_DIR="./test_php_files"

# Number of PHP files to create
NUM_FILES=50

# Create output directory if it doesn't exist
mkdir -p "$OUTPUT_DIR"

# Loop to create files
for i in $(seq 1 $NUM_FILES); do
  FILE="$OUTPUT_DIR/file_$i.php"
  cat > "$FILE" << EOF
<?php
// Sample PHP file number $i

function testFunction$i() {
    // Simple function to test SonarQube scan
    echo "This is test function number $i\n";
}

testFunction$i();
?>
EOF

  echo "Created $FILE"
done

echo "Created $NUM_FILES PHP files in $OUTPUT_DIR"
